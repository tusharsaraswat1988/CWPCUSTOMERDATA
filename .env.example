# =====================================================================
# CWP DETAILERS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit actual credentials or database URLs to version control.
# =====================================================================

# 1. SERVER & RUNTIME
PORT=3000
NODE_ENV=production
RAILWAY_PUBLIC_DOMAIN=cwpdata.up.railway.app

# 2. NEON POSTGRESQL (PRIMARY DATABASE)
# Target Database: cwp_customer_db (STRICT: Never use neondb)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/cwp_customer_db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.region.neon.tech/cwp_customer_db?sslmode=require
DB_PROVIDER=neon_postgresql

# 3. ADMIN AUTHENTICATION
ADMIN_PASSWORD=your_secure_admin_password_here

# 4. CLOUDINARY CDN CONFIGURATION (OPTIONAL FOR VEHICLE PHOTOS)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# 5. LEGACY BACKUP CONFIGURATION (OPTIONAL / DISABLED IN NEON MODE)
DISABLE_LIVE_SHEETS=true
SPREADSHEET_ID=1IXs46tRE324YYgBBAKxD1aCCnYVzmqfX4jxCWvfiALY
GID_DAILY_CLEAN=508927146
GID_ALL_OTHER_WORK=866987332
APPS_SCRIPT_URL=https://script.google.com/macros/s/sample/exec
APPS_SCRIPT_SERVICE_KEY=
