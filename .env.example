# =====================================================================
# CWP DETAILERS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit actual credentials or database URLs to version control.
# =====================================================================

# 1. SERVER & RUNTIME
PORT=3000
NODE_ENV=production
RAILWAY_PUBLIC_DOMAIN=cwpdata.up.railway.app

# 2. NEON POSTGRESQL (PRIMARY DATABASE)
# Target Database: cwp_customer_db (STRICT: Never use neondb)
DATABASE_URL=postgresql://neondb_owner:<password>@ep-wild-wave-b3b9l7xf-pooler.c-4.ap-southeast-1.aws.neon.tech/cwp_customer_db?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@ep-wild-wave-b3b9l7xf.c-4.ap-southeast-1.aws.neon.tech/cwp_customer_db?sslmode=require&channel_binding=require
DB_PROVIDER=neon_postgresql

# 3. ADMIN AUTHENTICATION
ADMIN_PASSWORD=your_secure_admin_password_here

# 4. CLOUDINARY CDN CONFIGURATION (VEHICLE PHOTOS STORAGE)
CLOUDINARY_CLOUD_NAME=dhfphz6nv
CLOUDINARY_API_KEY=872657743383961
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# 5. DATA SOURCE MODE
# Set to 'true' to run 100% on Neon PostgreSQL without calling Google Sheets
DISABLE_LIVE_SHEETS=true

# 6. LEGACY BACKUP CONFIGURATION (OPTIONAL / DEPRECATED IN NEON MODE)
