# =====================================================================
# CWP DATA APP - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NEON POSTGRESQL ARCHITECTURE ONLY
# =====================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit actual credentials or database URLs to version control.
# =====================================================================

# 1. SERVER & RUNTIME
PORT=3000
NODE_ENV=production
RAILWAY_PUBLIC_DOMAIN=cwpdata.up.railway.app

# 2. POSTGRESQL / NEON (PRIMARY DATABASE)
# Single Source of Truth: Only DATABASE_URL is required (on Neon, Supabase, AWS RDS, or Localhost).
# For Neon, the app automatically derives direct/pooled connections for migrations and runtime.
# Any database name (neondb, cwp_customer_db, production, postgres) in the URL is handled dynamically.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# OPTIONAL: Explicit unpooled direct connection override (only if needed)
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require

# 3. ADMIN AUTHENTICATION
ADMIN_PASSWORD=your_secure_admin_password_here

# 4. CLOUDINARY CDN CONFIGURATION (OPTIONAL FOR VEHICLE PHOTOS)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# 5. GOOGLE MAPS API (OPTIONAL FOR ADMIN FLEET TRACKING)
# If provided, the Admin Fleet Tracking console loads Google Maps JavaScript API.
# If omitted or left blank, the app automatically falls back to free Leaflet/OpenStreetMap.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
