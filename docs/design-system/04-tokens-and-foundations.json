{
  "$description": "CWP Aura Design System — DTCG 2025.10 Compliant Design Tokens for CWP Customer Data & Staff Portal",
  "version": "1.0.0",
  "color": {
    "primitive": {
      "navy": {
        "950": { "$type": "color", "$value": "#07101c", "$description": "Ultra deep navy" },
        "900": { "$type": "color", "$value": "#0b192c", "$description": "CWP Brand primary navy" },
        "800": { "$type": "color", "$value": "#0f2942", "$description": "CWP Secondary automotive navy" }
      },
      "slate": {
        "50":  { "$type": "color", "$value": "#f8fafc", "$description": "Light canvas background" },
        "100": { "$type": "color", "$value": "#f1f5f9", "$description": "Tonal surface container low" },
        "200": { "$type": "color", "$value": "#e2e8f0", "$description": "Subtle border and divider" },
        "300": { "$type": "color", "$value": "#cbd5e1", "$description": "Control outline and input border" },
        "400": { "$type": "color", "$value": "#94a3b8", "$description": "Muted placeholder and inactive icon" },
        "500": { "$type": "color", "$value": "#64748b", "$description": "Metadata and tertiary text" },
        "600": { "$type": "color", "$value": "#475569", "$description": "Secondary body text" },
        "700": { "$type": "color", "$value": "#334155", "$description": "Section subheadings" },
        "800": { "$type": "color", "$value": "#1e293b", "$description": "Dark container background" },
        "900": { "$type": "color", "$value": "#0f172a", "$description": "Primary high-contrast dark text" },
        "950": { "$type": "color", "$value": "#0b0f17", "$description": "Dark mode canvas background" }
      },
      "blue": {
        "50":  { "$type": "color", "$value": "#eff6ff", "$description": "Light primary highlight tint" },
        "100": { "$type": "color", "$value": "#dbeafe", "$description": "Primary action container" },
        "200": { "$type": "color", "$value": "#bfdbfe", "$description": "Focus ring indicator tint" },
        "600": { "$type": "color", "$value": "#2563eb", "$description": "Interactive cobalt primary" },
        "700": { "$type": "color", "$value": "#1d4ed8", "$description": "Primary action solid background" },
        "800": { "$type": "color", "$value": "#1e3a8a", "$description": "Deep action text on container" }
      },
      "green": {
        "50":  { "$type": "color", "$value": "#ecfdf5", "$description": "Success light tint" },
        "100": { "$type": "color", "$value": "#d1fae5", "$description": "Success container low" },
        "600": { "$type": "color", "$value": "#059669", "$description": "Completed status and call action" },
        "700": { "$type": "color", "$value": "#047857", "$description": "Completed action active state" },
        "900": { "$type": "color", "$value": "#064e3b", "$description": "Success text on container" }
      },
      "amber": {
        "50":  { "$type": "color", "$value": "#fffbeb", "$description": "Caution light tint" },
        "100": { "$type": "color", "$value": "#fef3c7", "$description": "Aaj/Kal rotation container" },
        "600": { "$type": "color", "$value": "#d97706", "$description": "Alternate-day rotation alert" },
        "700": { "$type": "color", "$value": "#b45309", "$description": "Warning active state" },
        "900": { "$type": "color", "$value": "#78350f", "$description": "Caution text on container" }
      },
      "red": {
        "50":  { "$type": "color", "$value": "#fef2f2", "$description": "Error light tint" },
        "100": { "$type": "color", "$value": "#fee2e2", "$description": "Destructive container" },
        "600": { "$type": "color", "$value": "#dc2626", "$description": "Destructive action & error alert" },
        "700": { "$type": "color", "$value": "#b91c1c", "$description": "Destructive button pressed" },
        "900": { "$type": "color", "$value": "#7f1d1d", "$description": "Error text on container" }
      }
    },
    "semantic": {
      "surface": {
        "canvas":       { "$type": "color", "$value": "{color.primitive.slate.50}", "$description": "Main viewport canvas" },
        "card":         { "$type": "color", "$value": "#ffffff", "$description": "Customer and operational cards" },
        "container-low":{ "$type": "color", "$value": "{color.primitive.slate.100}", "$description": "Subtle groupings within cards" },
        "header":       { "$type": "color", "$value": "{color.primitive.navy.900}", "$description": "Persistent top brand header" }
      },
      "text": {
        "primary":      { "$type": "color", "$value": "{color.primitive.slate.900}", "$description": "High-contrast text" },
        "secondary":    { "$type": "color", "$value": "{color.primitive.slate.600}", "$description": "Secondary labels and addresses" },
        "muted":        { "$type": "color", "$value": "{color.primitive.slate.500}", "$description": "Timestamps and helper notes" },
        "on-header":    { "$type": "color", "$value": "#ffffff", "$description": "Header text on dark navy" },
        "on-action":    { "$type": "color", "$value": "#ffffff", "$description": "Text on solid primary button" }
      },
      "action": {
        "primary":      { "$type": "color", "$value": "{color.primitive.blue.700}", "$description": "Primary action background" },
        "primary-hover":{ "$type": "color", "$value": "{color.primitive.blue.600}", "$description": "Primary action hover" },
        "call":         { "$type": "color", "$value": "{color.primitive.green.600}", "$description": "One-tap customer call action" },
        "navigate":     { "$type": "color", "$value": "{color.primitive.blue.600}", "$description": "One-tap GPS navigation action" },
        "destructive":  { "$type": "color", "$value": "{color.primitive.red.600}", "$description": "Delete / Reset action" }
      },
      "status": {
        "success":      { "$type": "color", "$value": "{color.primitive.green.600}", "$description": "Cleaned / completed status" },
        "success-bg":   { "$type": "color", "$value": "{color.primitive.green.100}", "$description": "Completed badge background" },
        "warning":      { "$type": "color", "$value": "{color.primitive.amber.600}", "$description": "Aaj/Kal rotation and pending sync" },
        "warning-bg":   { "$type": "color", "$value": "{color.primitive.amber.100}", "$description": "Rotation banner background" },
        "error":        { "$type": "color", "$value": "{color.primitive.red.600}", "$description": "Failed validation and missed stop" },
        "error-bg":     { "$type": "color", "$value": "{color.primitive.red.100}", "$description": "Error banner background" }
      },
      "border": {
        "subtle":       { "$type": "color", "$value": "{color.primitive.slate.200}", "$description": "Card and table separator border" },
        "input":        { "$type": "color", "$value": "{color.primitive.slate.300}", "$description": "Form input default border" },
        "focus":        { "$type": "color", "$value": "{color.primitive.blue.600}", "$description": "Keyboard accessible focus ring" }
      }
    },
    "component": {
      "license-plate": {
        "bg-white":     { "$type": "color", "$value": "#ffffff", "$description": "Standard private Indian registration plate" },
        "bg-amber":     { "$type": "color", "$value": "#fde047", "$description": "Commercial Indian vehicle registration plate" },
        "text":         { "$type": "color", "$value": "#000000", "$description": "Crisp black monospace plate lettering" },
        "border":       { "$type": "color", "$value": "{color.primitive.navy.900}", "$description": "Plate border frame" },
        "ind-badge":    { "$type": "color", "$value": "{color.primitive.blue.700}", "$description": "IND country identifier" }
      },
      "bottom-nav": {
        "bg":           { "$type": "color", "$value": "#ffffff", "$description": "Staff bottom bar background" },
        "active-color": { "$type": "color", "$value": "{color.primitive.blue.700}", "$description": "Active tab text and icon" },
        "active-pill":  { "$type": "color", "$value": "{color.primitive.blue.100}", "$description": "Active tab pill container" },
        "inactive-color":{ "$type": "color", "$value": "{color.primitive.slate.500}", "$description": "Inactive tab icon and text" }
      }
    }
  },
  "space": {
    "primitive": {
      "4":  { "$type": "dimension", "$value": "4px", "$description": "Half grid unit" },
      "8":  { "$type": "dimension", "$value": "8px", "$description": "Base grid unit" },
      "12": { "$type": "dimension", "$value": "12px", "$description": "1.5 grid units" },
      "16": { "$type": "dimension", "$value": "16px", "$description": "2 grid units" },
      "24": { "$type": "dimension", "$value": "24px", "$description": "3 grid units" },
      "32": { "$type": "dimension", "$value": "32px", "$description": "4 grid units" },
      "48": { "$type": "dimension", "$value": "48px", "$description": "6 grid units / min touch target" }
    },
    "semantic": {
      "touch-target-min": { "$type": "dimension", "$value": "{space.primitive.48}", "$description": "Field staff min touch height/width" },
      "card-padding":     { "$type": "dimension", "$value": "{space.primitive.16}", "$description": "Customer card internal padding" },
      "card-gap":         { "$type": "dimension", "$value": "{space.primitive.12}", "$description": "Feed vertical gap between cards" },
      "button-gap":       { "$type": "dimension", "$value": "{space.primitive.8}", "$description": "Separation between action buttons" },
      "screen-margin":    { "$type": "dimension", "$value": "{space.primitive.16}", "$description": "Mobile page outer horizontal margin" }
    }
  },
  "typography": {
    "font-family": {
      "primary":   { "$type": "fontFamily", "$value": "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
      "indic":     { "$type": "fontFamily", "$value": "'Noto Sans Devanagari', 'Poppins', sans-serif" },
      "monospace": { "$type": "fontFamily", "$value": "'JetBrains Mono', 'SFMono-Regular', Consolas, monospace" }
    },
    "size": {
      "11": { "$type": "dimension", "$value": "11px", "$description": "Caption micro" },
      "13": { "$type": "dimension", "$value": "13px", "$description": "Label bold / action text" },
      "14": { "$type": "dimension", "$value": "14px", "$description": "Body standard / Devanagari text" },
      "15": { "$type": "dimension", "$value": "15px", "$description": "Body prominent / address" },
      "16": { "$type": "dimension", "$value": "16px", "$description": "Title card heading" },
      "20": { "$type": "dimension", "$value": "20px", "$description": "Headline modal section" },
      "28": { "$type": "dimension", "$value": "28px", "$description": "Display hero" }
    },
    "line-height": {
      "tight": { "$type": "dimension", "$value": "1.2", "$description": "Monospace and badges" },
      "snug":  { "$type": "dimension", "$value": "1.3", "$description": "Headings and labels" },
      "body":  { "$type": "dimension", "$value": "1.5", "$description": "Devanagari and Latin body copy" }
    }
  },
  "shape": {
    "radius": {
      "xs":   { "$type": "dimension", "$value": "4px", "$description": "Badges and monospace chips" },
      "sm":   { "$type": "dimension", "$value": "8px", "$description": "Buttons, inputs, sub-containers" },
      "md":   { "$type": "dimension", "$value": "12px", "$description": "Customer cards, KPI tiles" },
      "lg":   { "$type": "dimension", "$value": "16px", "$description": "Bottom sheets, large modal windows" },
      "full": { "$type": "dimension", "$value": "9999px", "$description": "Pill badges, avatars, icon buttons" }
    }
  },
  "elevation": {
    "level-0": { "$type": "shadow", "$value": "none", "$description": "Flat" },
    "level-1": { "$type": "shadow", "$value": "0 1px 3px 1px rgba(15, 23, 42, 0.08), 0 1px 2px 0 rgba(15, 23, 42, 0.12)", "$description": "Subtle card depth" },
    "level-2": { "$type": "shadow", "$value": "0 2px 6px 2px rgba(15, 23, 42, 0.08), 0 1px 2px 0 rgba(15, 23, 42, 0.14)", "$description": "Raised sticky bottom bar" },
    "level-3": { "$type": "shadow", "$value": "0 4px 8px 3px rgba(15, 23, 42, 0.10), 0 1px 3px 0 rgba(15, 23, 42, 0.16)", "$description": "Floating modal dialog" },
    "level-4": { "$type": "shadow", "$value": "0 6px 10px 4px rgba(15, 23, 42, 0.10), 0 2px 3px 0 rgba(15, 23, 42, 0.16)", "$description": "Sheet overlay" }
  },
  "motion": {
    "duration": {
      "instant":  { "$type": "duration", "$value": "100ms", "$description": "Toggles, checkboxes, press feedback" },
      "rapid":    { "$type": "duration", "$value": "200ms", "$description": "Toasts, menus, chip transitions" },
      "standard": { "$type": "duration", "$value": "300ms", "$description": "Modals, drawers, route shifts" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0, 1.0], "$description": "Decelerate curve" }
    }
  }
}
